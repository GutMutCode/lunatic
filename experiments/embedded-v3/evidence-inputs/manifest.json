      "identity": "The exact selected tar bytes, byte length, and SHA-256; no static path or placeholder hash is valid before creation."
    },
    "oracle_executable": {
      "run_manifest_field": "oracle.executable",
      "status": "bind_after_release_build",
      "artifact_kind": "release_executable",
      "identity": "The exact executable bytes, byte length, and SHA-256 built from oracle_source_snapshot; no static path or placeholder hash is valid before creation."
    }
  },
  "source_snapshot_rules": {
    "common": {
      "format": "uncompressed tar",
      "excluded": [
        "target",
        ".git",
        ".hg",
        ".svn"
      ],
      "creation": "Create the tar once after the corresponding source freeze. Do not regenerate or overwrite it after measurement preparation; any later included-source change requires a new snapshot and execution freeze.",
      "verification": "Compare every current non-excluded regular file path, byte length, and SHA-256 with the archive before execution. Directory headers, entry order, modes, timestamps, padding, and all other tar bytes remain part of the snapshot identity.",
      "authority": "The byte length and SHA-256 of the exact fixed tar actually supplied to the run are authoritative. A reconstructed archive with identical extracted files is not interchangeable unless its complete tar bytes have the recorded identity."
    },
    "oracle_source_snapshot": {
      "archive_root": "The frozen Oracle source root contents appear below ./ in the archive.",
      "included": "Every non-excluded file needed to build and audit the common Oracle, including its Cargo manifests and lockfile, crates, schemas, and source. Its concrete path, byte length, and hash are intentionally deferred until the Oracle tar is created."
    },
    "candidate_source_snapshot": {
      "archive_root": "The candidate directory contents appear below ./ in the archive.",
      "included": "Every file and directory intended for the frozen candidate tree, including Cargo.toml, Cargo.lock, sloc-manifest.json, src, tests, and guest-artifacts."
    }
  },
