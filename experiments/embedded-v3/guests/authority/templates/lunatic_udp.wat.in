(module
  (import "lunatic::networking" "udp_bind"
    (func $udp_bind (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "lunatic::networking" "udp_send_to"
    (func $udp_send_to (param i64 i32 i32 i32 i32 i32 i32 i32 i32) (result i32)))
  (import "lunatic::networking" "drop_udp_socket"
    (func $drop_udp_socket (param i64)))

  (memory (export "memory") 1)
  (data (i32.const 1024) "__PARAM_BLOB__")
  (data (i32.const 4096) "__IPV4_BYTES__")
  (data (i32.const 8192) "__NONCE_BYTES__")

  (func (export "parameter_ptr") (result i32) (i32.const 1024))
  (func (export "parameter_len") (result i32) (i32.const __PARAM_LEN__))

  (func (export "invoke") (result i32)
    (local $status i32)
    (local $socket i64)

    (local.set $status
      (call $udp_bind
        (i32.const 4) (i32.const 4096) (i32.const 0)
        (i32.const 0) (i32.const 0) (i32.const 80)))
    (if (i32.ne (local.get $status) (i32.const 0))
      (then (return (local.get $status))))

    (local.set $socket (i64.load (i32.const 80)))
    (local.set $status
      (call $udp_send_to
        (local.get $socket)
        (i32.const 8192) (i32.const __NONCE_LEN__)
        (i32.const 4) (i32.const 4096) (i32.const __UDP_PORT__)
        (i32.const 0) (i32.const 0) (i32.const 88)))
    (call $drop_udp_socket (local.get $socket))
    (if (i32.ne (local.get $status) (i32.const 0))
      (then (return (local.get $status))))
    (if (i64.ne (i64.load (i32.const 88)) (i64.const __NONCE_LEN__))
      (then (return (i32.const 2))))
    (i32.const 0))
)
