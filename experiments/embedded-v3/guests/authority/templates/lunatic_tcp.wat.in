(module
  (import "lunatic::networking" "tcp_connect"
    (func $tcp_connect (param i32 i32 i32 i32 i32 i64 i32) (result i32)))
  (import "lunatic::networking" "tcp_write_vectored"
    (func $tcp_write_vectored (param i64 i32 i32 i32) (result i32)))
  (import "lunatic::networking" "drop_tcp_stream"
    (func $drop_tcp_stream (param i64)))

  (memory (export "memory") 1)
  (data (i32.const 1024) "__PARAM_BLOB__")
  (data (i32.const 4096) "__IPV4_BYTES__")
  (data (i32.const 8192) "__NONCE_BYTES__")

  (func (export "parameter_ptr") (result i32) (i32.const 1024))
  (func (export "parameter_len") (result i32) (i32.const __PARAM_LEN__))

  (func (export "invoke") (result i32)
    (local $status i32)
    (local $stream i64)

    (local.set $status
      (call $tcp_connect
        (i32.const 4) (i32.const 4096) (i32.const __TCP_PORT__)
        (i32.const 0) (i32.const 0) (i64.const 1000) (i32.const 80)))
    (if (i32.ne (local.get $status) (i32.const 0))
      (then (return (local.get $status))))

    (local.set $stream (i64.load (i32.const 80)))
    (i32.store (i32.const 64) (i32.const 8192))
    (i32.store (i32.const 68) (i32.const __NONCE_LEN__))
    (local.set $status
      (call $tcp_write_vectored
        (local.get $stream) (i32.const 64) (i32.const 1) (i32.const 88)))
    (call $drop_tcp_stream (local.get $stream))
    (if (i32.ne (local.get $status) (i32.const 0))
      (then (return (local.get $status))))
    (if (i64.ne (i64.load (i32.const 88)) (i64.const __NONCE_LEN__))
      (then (return (i32.const 2))))
    (i32.const 0))
)
