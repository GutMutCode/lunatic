(module
  (import "wasi_snapshot_preview1" "path_open"
    (func $path_open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read"
    (func $fd_read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_close"
    (func $fd_close (param i32) (result i32)))

  (memory (export "memory") 1)
  (data (i32.const 1024) "__PARAM_BLOB__")
  (data (i32.const 4096) "__PATH_BYTES__")
  (data (i32.const 8192) "__NONCE_BYTES__")

  (func (export "parameter_ptr") (result i32) (i32.const 1024))
  (func (export "parameter_len") (result i32) (i32.const __PARAM_LEN__))

  (func (export "invoke") (result i32)
    (local $errno i32)
    (local $fd i32)
    (local $index i32)

    (local.set $errno
      (call $path_open
        (i32.const __PREOPEN_FD__) (i32.const 0)
        (i32.const 4096) (i32.const __PATH_LEN__)
        (i32.const 0) (i64.const 2) (i64.const 0)
        (i32.const 0) (i32.const 80)))
    (if (i32.ne (local.get $errno) (i32.const 0))
      (then (return (local.get $errno))))

    (local.set $fd (i32.load (i32.const 80)))
    (i32.store (i32.const 64) (i32.const 12288))
    (i32.store (i32.const 68) (i32.const __NONCE_LEN__))
    (local.set $errno
      (call $fd_read
        (local.get $fd) (i32.const 64) (i32.const 1) (i32.const 72)))
    (drop (call $fd_close (local.get $fd)))
    (if (i32.ne (local.get $errno) (i32.const 0))
      (then (return (local.get $errno))))
    (if (i32.ne (i32.load (i32.const 72)) (i32.const __NONCE_LEN__))
      (then (return (i32.const 125))))

    (block $done
      (loop $compare
        (br_if $done
          (i32.ge_u (local.get $index) (i32.const __NONCE_LEN__)))
        (if
          (i32.ne
            (i32.load8_u (i32.add (i32.const 12288) (local.get $index)))
            (i32.load8_u (i32.add (i32.const 8192) (local.get $index))))
          (then (return (i32.const 126))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $compare)))
    (i32.const 0))
)
